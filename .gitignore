# Explicitly exclude Polyphone reference codebase (third-party code, kept locally only)
polyphone Source Code/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Rust: KEEP Cargo.lock (this is a binary app, not a library — lock file must be committed)
# Only exclude the actual compiled output directory
HarmoniumWorkstation/target/

# Editor / IDE artifacts
.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
